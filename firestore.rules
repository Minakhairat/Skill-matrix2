rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & Email helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && ('email_verified' in request.auth.token ? request.auth.token.email_verified == true : true);
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict multi-admin isolation: Only the creator admin can manage their lines
    function isLineAdmin(lineData) {
      return isSignedIn() && (
        ('adminId' in lineData && lineData.adminId == request.auth.uid) ||
        ('adminEmail' in lineData && (lineData.adminEmail == userEmail() || lineData.adminEmail == request.auth.token.email))
      );
    }

    // Assigned supervisor can only access their specific lines
    function isLineSupervisor(lineData) {
      return isSignedIn() && (
        lineData.supervisorEmail == request.auth.token.email ||
        lineData.supervisorEmail == userEmail() ||
        ('supervisorEmail' in lineData && (lineData.supervisorEmail == request.auth.token.email || lineData.supervisorEmail == userEmail()))
      );
    }

    // Strict multi-admin isolation: Only the creator admin can manage their workers
    function isWorkerAdmin(workerData) {
      return isSignedIn() && (
        ('adminId' in workerData && workerData.adminId == request.auth.uid) ||
        ('adminEmail' in workerData && (workerData.adminEmail == userEmail() || workerData.adminEmail == request.auth.token.email))
      );
    }

    // Assigned supervisor can only access workers on their specific line or matching their email
    function isWorkerSupervisor(workerData) {
      return isSignedIn() && (
        workerData.supervisorEmail == request.auth.token.email ||
        workerData.supervisorEmail == userEmail() ||
        ('supervisorEmail' in workerData && (workerData.supervisorEmail == request.auth.token.email || workerData.supervisorEmail == userEmail()))
      );
    }

    // Schema validations
    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.keys().hasOnly(['uid', 'email', 'role', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'assignedLineIds', 'adminEmail', 'assignedAdminEmail', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             (data.role == 'admin' || data.role == 'supervisor') &&
             (!('assignedLineIds' in data) || data.assignedLineIds is list);
    }

    function isValidLine(data) {
      return data.keys().hasAll(['id', 'name']) &&
             data.keys().hasOnly(['id', 'name', 'nameEn', 'code', 'supervisor', 'supervisorEmail', 'supervisorName', 'adminEmail', 'adminId', 'shiftCount', 'models', 'updatedAt', 'updatedBy']) &&
             data.id is string && data.id.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             (!('adminEmail' in data) || (data.adminEmail is string && data.adminEmail.size() <= 128)) &&
             (!('adminId' in data) || (data.adminId is string && data.adminId.size() <= 128)) &&
             (!('supervisorEmail' in data) || (data.supervisorEmail is string && data.supervisorEmail.size() <= 128)) &&
             (!('shiftCount' in data) || data.shiftCount is number) &&
             (!('models' in data) || data.models is list);
    }

    function isValidWorker(data) {
      return data.keys().hasAll(['id', 'code', 'name', 'lineId']) &&
             data.keys().hasOnly(['id', 'code', 'name', 'department', 'lineId', 'shift', 'skills', 'performanceRate', 'notes', 'hireDate', 'adminEmail', 'adminId', 'supervisorEmail', 'targetStagesCount', 'minProficiencyTarget', 'updatedAt', 'updatedBy']) &&
             data.id is string && data.id.size() <= 64 &&
             data.code is string && data.code.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             data.lineId is string && data.lineId.size() <= 64 &&
             (!('adminEmail' in data) || (data.adminEmail is string && data.adminEmail.size() <= 128)) &&
             (!('adminId' in data) || (data.adminId is string && data.adminId.size() <= 128)) &&
             (!('supervisorEmail' in data) || (data.supervisorEmail is string && data.supervisorEmail.size() <= 128)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('performanceRate' in data) || data.performanceRate is number);
    }

    function isValidPlantSettings(data) {
      return data.keys().hasAll(['targetWorkersPerStage', 'targetStagesPerWorker']) &&
             data.keys().hasOnly(['targetWorkersPerStage', 'targetStagesPerWorker', 'minQualifiedLevel', 'terminology', 'leadership', 'adminEmail', 'adminId', 'updatedAt', 'updatedBy']) &&
             data.targetWorkersPerStage is number &&
             data.targetStagesPerWorker is number;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'timestamp', 'actionType', 'title']) &&
             data.keys().hasOnly(['id', 'timestamp', 'actionType', 'title', 'details', 'badgeLabel', 'badgeClass', 'actorEmail', 'adminEmail']) &&
             data.id is string && data.id.size() <= 128 &&
             data.timestamp is string && data.timestamp.size() <= 64 &&
             data.actionType is string && data.actionType.size() <= 64 &&
             data.title is string && data.title.size() <= 200 &&
             (!('details' in data) || (data.details is string && data.details.size() <= 2000));
    }

    // Admins Collection (Strictly scoped to user UID, cannot escalate privileges across admins)
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list: if isSignedIn() && request.auth.uid == adminId;
      allow create, update: if isValidId(adminId) && isValidAdmin(incoming()) && request.auth.uid == adminId;
      allow delete: if request.auth.uid == adminId;
    }

    // Users Collection (Profile scoped to the user)
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isValidId(userId) && isValidUserProfile(incoming()) && (
        request.auth.uid == userId ||
        ('adminEmail' in incoming() && incoming().adminEmail.lower() == userEmail()) ||
        ('assignedAdminEmail' in incoming() && incoming().assignedAdminEmail.lower() == userEmail())
      );
      allow delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Lines Collection: Scoped strictly per Admin; supervisor has read and limited update for assigned line
    match /lines/{lineId} {
      allow get: if isSignedIn() && (
        isLineAdmin(resource.data) || isLineSupervisor(resource.data)
      );
      allow list: if isSignedIn() && (
        isLineAdmin(resource.data) || isLineSupervisor(resource.data)
      );
      allow create: if isSignedIn() && isValidId(lineId) && isValidLine(incoming()) && (
        ('adminId' in incoming() && incoming().adminId == request.auth.uid) ||
        ('adminEmail' in incoming() && (incoming().adminEmail == userEmail() || incoming().adminEmail == request.auth.token.email))
      );
      allow update: if isSignedIn() && isValidId(lineId) && isValidLine(incoming()) && (
        (isLineAdmin(resource.data) && (!('adminEmail' in existing()) || !('adminEmail' in incoming()) || incoming().adminEmail == existing().adminEmail || incoming().adminEmail.lower() == existing().adminEmail.lower())) ||
        (isLineSupervisor(resource.data) && (incoming().adminEmail == existing().adminEmail || incoming().adminEmail.lower() == existing().adminEmail.lower()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['models', 'supervisor', 'supervisorName', 'updatedAt', 'updatedBy']))
      );
      allow delete: if isSignedIn() && isValidId(lineId) && isLineAdmin(resource.data);
    }

    // Workers Collection: Scoped strictly per Admin; supervisor has read and operational update only
    match /workers/{workerId} {
      allow get: if isSignedIn() && (
        isWorkerAdmin(resource.data) || isWorkerSupervisor(resource.data)
      );
      allow list: if isSignedIn() && (
        isWorkerAdmin(resource.data) || isWorkerSupervisor(resource.data)
      );
      allow create: if isSignedIn() && isValidId(workerId) && isValidWorker(incoming()) && (
        ('adminId' in incoming() && incoming().adminId == request.auth.uid) ||
        ('adminEmail' in incoming() && (incoming().adminEmail == userEmail() || incoming().adminEmail == request.auth.token.email))
      );
      allow update: if isSignedIn() && isValidId(workerId) && isValidWorker(incoming()) && (
        (isWorkerAdmin(resource.data) && (!('adminEmail' in existing()) || !('adminEmail' in incoming()) || incoming().adminEmail == existing().adminEmail || incoming().adminEmail.lower() == existing().adminEmail.lower())) ||
        (isWorkerSupervisor(resource.data) && (incoming().adminEmail == existing().adminEmail || incoming().adminEmail.lower() == existing().adminEmail.lower()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['skills', 'shift', 'performanceRate', 'notes', 'updatedAt', 'updatedBy']))
      );
      allow delete: if isSignedIn() && isValidId(workerId) && isWorkerAdmin(resource.data);
    }

    // Settings Collection: Scoped per admin workspace
    match /settings/{settingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(settingId) && isValidPlantSettings(incoming()) && (
        settingId == request.auth.uid || ('adminEmail' in incoming() && incoming().adminEmail.lower() == userEmail())
      );
      allow delete: if isSignedIn() && (settingId == request.auth.uid || ('adminEmail' in existing() && existing().adminEmail.lower() == userEmail()));
    }

    // Audit Logs Collection (Append-only)
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId) && isValidAuditLog(incoming());
      allow update, delete: if false;
    }
  }
}
